# Laneguard configuration. Protected: only an owner may change this file.
project: {{PROJECT}}
repo: {{REPO}}
owners: {{OWNERS_YAML}}
approvals_required: {{APPROVALS_REQUIRED}}
profile: {{PROFILE}}
mode: propose

lanes:
{{LANES_YAML}}

validation:
  lint: "{{VALIDATION_LINT}}"
  test: "{{VALIDATION_TEST}}"
  build: "{{VALIDATION_BUILD}}"

limits:
  run_max_minutes: {{RUN_MAX_MINUTES}}
  lock_ttl_minutes: {{LOCK_TTL_MINUTES}}
  heartbeat_minutes: {{HEARTBEAT_MINUTES}}
  claim_expiry_hours: 24

budgets:
  per_run: { max_turns: 60, max_tokens: 2000000 }
  monthly_cost_ceiling_usd: 200
  max_open_prs_per_lane: 2
  max_issues_created_per_day: 5

circuit_breaker:
  consecutive_failures: 3
  same_pr_failures: 2

scheduler:
  adapter: github-actions

extra_gates: []
extra_protected_paths: []
