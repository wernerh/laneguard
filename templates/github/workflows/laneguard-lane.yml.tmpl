# Laneguard lane "{{LANE}}". Protected: owners only. Runs as the GitHub App bot identity, never an owner.
name: laneguard-lane-{{LANE}}
on:
  schedule:
    - cron: "{{CRON}}"
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: laneguard-{{LANE}}
  cancel-in-progress: false
jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: {{RUN_MAX_MINUTES}}
    steps:
      - uses: actions/create-github-app-token@{{APP_TOKEN_SHA}}
        id: app
        with:
          app-id: ${{ vars.LANEGUARD_APP_ID }}
          private-key: ${{ secrets.LANEGUARD_APP_PRIVATE_KEY }}
      - uses: actions/checkout@{{CHECKOUT_SHA}}
        with:
          fetch-depth: 0
          token: ${{ steps.app.outputs.token }}
      - name: Read the pinned engine commit
        id: pin
        run: |
          sha="$(grep '^sha:' .laneguard/plugin.lock | head -1 | awk '{print $2}')"
          # Refuse anything but a full commit SHA: a branch or tag here would let the engine move under the pin.
          if ! [[ "$sha" =~ ^[0-9a-f]{40}$ ]]; then
            echo "::error file=.laneguard/plugin.lock::sha '$sha' is not a full 40-character commit SHA; refusing to check out the engine"
            exit 1
          fi
          echo "sha=$sha" >> "$GITHUB_OUTPUT"
      - uses: actions/checkout@{{CHECKOUT_SHA}}
        with:
          repository: {{ENGINE_REPO}}
          ref: ${{ steps.pin.outputs.sha }}
          path: laneguard-engine
          persist-credentials: false
      - uses: anthropics/claude-code-action@{{CLAUDE_ACTION_SHA}}
        env:
          GH_TOKEN: ${{ steps.app.outputs.token }}
          CLAUDE_PLUGIN_ROOT: ${{ github.workspace }}/laneguard-engine
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          github_token: ${{ steps.app.outputs.token }}
          prompt: "/laneguard:run {{LANE}}"
          claude_args: --plugin-dir ${{ github.workspace }}/laneguard-engine --max-turns {{MAX_TURNS}}
