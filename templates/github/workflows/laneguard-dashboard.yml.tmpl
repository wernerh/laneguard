# Laneguard dashboard (optional). Protected: owners only. Builds a static status page from the
# laneguard-data branch and uploads it as a workflow artifact. It publishes nothing anywhere.
name: laneguard-dashboard
on:
  schedule:
    - cron: "17 5 * * *"
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: laneguard-dashboard
  cancel-in-progress: true
jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@{{CHECKOUT_SHA}}
        with:
          fetch-depth: 0
          persist-credentials: false
      - name: Read the pinned engine commit
        id: pin
        run: |
          sha="$(grep '^sha:' .laneguard/plugin.lock | head -1 | awk '{print $2}')"
          # Refuse anything but a full commit SHA: a branch or tag here would let the engine move under the pin.
          if ! [[ "$sha" =~ ^[0-9a-f]{40}$ ]]; then
            echo "::error file=.laneguard/plugin.lock::sha '$sha' is not a full 40-character commit SHA; refusing to check out the engine"
            exit 1
          fi
          echo "sha=$sha" >> "$GITHUB_OUTPUT"
      - uses: actions/checkout@{{CHECKOUT_SHA}}
        with:
          repository: {{ENGINE_REPO}}
          ref: ${{ steps.pin.outputs.sha }}
          path: laneguard-engine
          persist-credentials: false
      - name: Build the dashboard
        run: |
          python3 laneguard-engine/dashboard/build.py \
            --from-git . \
            --branch laneguard-data \
            --config .laneguard/config.yaml \
            --out site/index.html
      - uses: actions/upload-artifact@b4b15b8c7c6ac21ea08fcf65892d2ee8f75cf882
        with:
          name: laneguard-dashboard
          path: site/index.html
          if-no-files-found: error
          retention-days: 14
