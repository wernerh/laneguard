name: ci
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@{{CHECKOUT_SHA}}
        with:
          persist-credentials: false
      - uses: actions/setup-python@{{SETUP_PYTHON_SHA}}
        with:
          python-version: "3.12"
      - name: install
        run: if [ -f requirements.txt ]; then python -m pip install -r requirements.txt; fi
      - name: lint
        run: {{VALIDATION_LINT_OR_TRUE}}
      - name: test
        run: {{VALIDATION_TEST_OR_TRUE}}
      - name: build
        run: {{VALIDATION_BUILD_OR_TRUE}}
