name: ci
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@{{CHECKOUT_SHA}}
      - uses: actions/setup-python@{{SETUP_PYTHON_SHA}}
        with:
          python-version: "3.12"
      - run: python -m pip install -r requirements.txt
      - name: lint
        run: {{VALIDATION_LINT_OR_TRUE}}
      - name: test
        run: {{VALIDATION_TEST_OR_TRUE}}
      - name: build
        run: {{VALIDATION_BUILD_OR_TRUE}}
