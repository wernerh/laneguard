name: ci
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  validate:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@{{CHECKOUT_SHA}}
        with:
          persist-credentials: false
      - uses: actions/setup-node@{{SETUP_NODE_SHA}}
        with:
          node-version: 20
      - name: install
        run: if [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then npm ci; else npm install; fi
      - name: lint
        run: {{VALIDATION_LINT_OR_TRUE}}
      - name: test
        run: {{VALIDATION_TEST_OR_TRUE}}
      - name: build
        run: {{VALIDATION_BUILD_OR_TRUE}}
